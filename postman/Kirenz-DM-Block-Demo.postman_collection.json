        {
          "id": "f8d57612-460b-4324-a452-842e96107a80",
          "name": "00.1 Dang ky tai khoan A moi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/api/auth/register",
            "description": "Request nay khoi tao run_id moi va reset cac bien demo. Luon chay setup tu request dau tien.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demo_email_a}}\",\n  \"username\": \"{{demo_username_a}}\",\n  \"password\": \"{{demo_password_a}}\",\n  \"displayName\": \"Kirenz demo A {{demo_run_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(()=>{",
                  "const run=Date.now().toString(36)+Math.random().toString(36).slice(2,7);",
                  "pm.environment.set('demo_run_id',run);",
                  "for(const actor of ['a','b']){",
                  "  pm.environment.set('demo_email_'+actor,'kirenz_demo_'+run+'_'+actor+'@example.invalid');",
                  "  pm.environment.set('demo_username_'+actor,'kirenz_demo_'+run+'_'+actor);",
                  "  pm.environment.set('demo_password_'+actor,'KirenzDemo!'+run+'_'+actor);",
                  "  pm.environment.set('demo_access_token_'+actor,'');",
                  "  pm.environment.set('demo_user_'+actor+'_id','');",
                  "}",
                  "pm.environment.set('demo_conversation_id','');",
                  "pm.environment.set('demo_call_id','');",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(()=>{",
                  "pm.test('HTTP 201',()=>pm.expect(pm.response.code).to.eql(201));",
                  "const response=pm.response.json();",
                  "pm.test('Success envelope',()=>pm.expect(response.success).to.eql(true));",
                  "if(pm.response.code===201 && pm.response.code<300){",
                  "  for(const capture of [{\"key\":\"demo_user_a_id\",\"path\":\"data.id\"}]){",
                  "    const value=capture.path.split('.').reduce((v,k)=>v==null?undefined:v[k],response);",
                  "    pm.test('Capture '+capture.key,()=>pm.expect(value).to.be.a('string').and.not.empty);",
                  "    if(typeof value==='string' && value)pm.environment.set(capture.key,value);",
                  "  }",
                  "}",
                  "",
                  "})();"
                ]
              }
            }
          ]
        },

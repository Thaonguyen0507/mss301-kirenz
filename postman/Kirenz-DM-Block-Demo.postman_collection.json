    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo co thu tu tren Gateway local18080 va User-service da sua block. Moi folder la mot phan trinh bay: setup tai khoan moi, success, B block A bi tu choi403, unblock success. HTTP403 mong doi van la test PASS. Khong goi video-access, khong kiem tra media LiveKit. Run collection de khong vuot thoi han ringing60s/heartbeat45s; hoac gui tungrequesttheothutu."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(()=>{",
          "const base=pm.environment.get('base_url');",
          "if(!['http://localhost:18080','http://127.0.0.1:18080'].includes(base)) throw new Error('Chon environment Kirenz | DM Block Demo, base_url=http://localhost:18080.');",
          "})();"
        ]
      }
    }
  ],

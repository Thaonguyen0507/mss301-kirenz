  "flows": [
    {
      "name": "Admin authorization boundaries",
      "description": "Verify distinct authentication and role failures on the public admin gateway routes.",
      "steps": [
        {
          "endpointId": "admin_ping",
          "actor": "admin",
          "assertions": [
            "data.status UP; data.adminId matches provisionedadmin"
          ]
        },
        {
          "endpointId": "admin_ping",
          "actor": "a",
          "overrides": {
            "expectedStatuses": [
              403
            ]
          },
          "assertions": [
            "403 Administrator access is required"
          ]
        },
        {
          "endpointId": "admin_ping",
          "actor": "a",
          "overrides": {
            "auth": "none",
            "expectedStatuses": [
              401
            ]
          },
          "assertions": [
            "401"
          ]
        }
      ]
    },
    {
      "name": "Report review/dismiss and notification delivery",
      "description": "A reports disposableB USERtarget, adminreviews anddismisses, reporter sees updatedstatus and eventuallyREPORT_UPDATE notification matchingreportID.",
      "steps": [
        {
          "endpointId": "admin_create_report",
          "actor": "a",
          "assertions": [
            "201; reporterId A; targetType USER; targetId B; status PENDING; capturereport_id"
          ]
        },
        {
          "endpointId": "admin_create_report",
          "actor": "a",
          "overrides": {
            "expectedStatuses": [
              400
            ]
          },
          "assertions": [
            "400 duplicate open report"
          ]
        },
        {
          "endpointId": "admin_my_reports",
          "actor": "a",
          "assertions": [
            "data.content contains own report"
          ]
        },
        {
          "endpointId": "admin_my_reports",
          "actor": "outsider",
          "assertions": [
            "data.content does not contain A's report"
          ]
        },
        {
          "endpointId": "admin_report_review",
          "actor": "admin",
          "assertions": [
            "data.status REVIEWING"
          ]
        },
        {
          "endpointId": "admin_report_review",
          "actor": "admin",
          "overrides": {
            "expectedStatuses": [
              400
            ]
          },
          "assertions": [
            "400 onlypending canstartreview"
          ]
        },
        {
          "endpointId": "admin_report_dismiss",
          "actor": "admin",
          "assertions": [
            "data.status DISMISSED; resolution NO_VIOLATION"
          ]
        },
        {
          "endpointId": "admin_report_detail",
          "actor": "admin",
          "assertions": [
            "data.report.id report_id; status DISMISSED; private adminNote available onlytoadmin"
          ]
        },
        {
          "endpointId": "admin_report_dismiss",
          "actor": "admin",
          "overrides": {
            "expectedStatuses": [
              400
            ]
          },
          "assertions": [
            "400 reportalreadyclosed"
          ]
        }
      ]
    },
    {
      "name": "Warning audit and target visibility through Kafka",
      "description": "Admin warns B; auditrecordandnotificationtargetactionID; B can inspectpublicmoderationdetail butA cannot. Userstatus remainsACTIVE.",
      "steps": [
        {
          "endpointId": "admin_user_warn",
          "actor": "admin",
          "assertions": [
            "data.actionType SEND_WARNING; targetType USER; targetId B; captureaction_id"
          ]
        },
        {
          "endpointId": "admin_user_actions",
          "actor": "admin",
          "assertions": [
            "content contains action_id with SEND_WARNING"
          ]
        },
        {
          "endpointId": "admin_target_action_detail",
          "actor": "b",
          "assertions": [
            "data.id action_id; reason OTHER; no adminnote property"
          ]
        },
        {
          "endpointId": "admin_target_action_detail",
          "actor": "a",
          "overrides": {
            "expectedStatuses": [
              404
            ]
          },

  "flows": [
    {
      "name": "Identity/User -> Chat direct conversation",
      "description": "Prerequisite A and B verified ACTIVE with DMallowed. Proves User-service permission query and Identity-service participant enrichment, idempotence and membership protection.",
      "steps": [
        {
          "endpointId": "chat_conversation_direct",
          "actor": "a",
          "assertions": [
            "data.type===DIRECT",
            "data.participants has actual user_a_id and user_b_id; usernames are not Unknown",
            "capture data.id -> conversation_id"
          ]
        },
        {
          "endpointId": "chat_conversation_direct",
          "actor": "a",
          "assertions": [
            "same conversation_id"
          ]
        },
        {
          "endpointId": "chat_conversation_list",
          "actor": "b",
          "assertions": [
            "contains conversation_id"
          ]
        },
        {
          "endpointId": "chat_conversation_get",
          "actor": "b",
          "assertions": [
            "same2participants"
          ]
        },
        {
          "endpointId": "chat_conversation_get",
          "actor": "outsider",
          "overrides": {
            "expectedStatuses": [
              400
            ]
          },
          "assertions": [
            "success===false; no participant details disclosed"
          ]
        }
      ]
    },
    {
      "name": "Group lifecycle and membership/admin permissions",
      "description": "Uses A/B/outsider as initial3members. Outsider is a group participant in this flow but remains outsider to A/Bdirect conversation. No fourth fixture needed.",
      "steps": [
        {
          "endpointId": "chat_conversation_create",
          "actor": "a",
          "assertions": [
            "GROUP has3members and Aadmin"
          ]
        },
        {
          "endpointId": "chat_conversation_rename",
          "actor": "b",
          "overrides": {
            "expectedStatuses": [
              400
            ]
          },
          "assertions": [
            "nonadmin rejected"
          ]
        },
        {
          "endpointId": "chat_conversation_rename",
          "actor": "a",
          "assertions": [
            "new trimmed name"
          ]
        },
        {
          "endpointId": "chat_conversation_remove_participant",
          "actor": "a",
          "assertions": [
            "outsider removed"

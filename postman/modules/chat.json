  "websocket": {
    "transport": "SockJS + STOMP1.2",
    "gatewayEndpoint": "{{base_url}}/ws/chat",
    "directServiceEndpoint": "{{chat_url}}/ws",
    "connectHeaders": {
      "Authorization": "Bearer {{access_token_a}}"
    },
    "send": [
      {
        "destination": "/app/chat.send",
        "body": {
          "conversationId": "{{conversation_id}}",
          "content": "Postman integration message {{run_id}}",
          "attachments": []
        },
        "constraints": "content.trim nonempty OR nonempty attachments; <=10IMAGE attachments; attachment.type IMAGE|VIDEO|FILE and url nonblank"
      },
      {
        "destination": "/app/chat.typing",
        "body": {
          "conversationId": "{{conversation_id}}",
          "isTyping": true
        }
      }
    ],
    "subscribe": [
      {
        "destination": "/user/queue/messages",
        "payload": "ConversationUpdateMessage {conversationId,conversationName,lastMessage,unreadCount,updatedAt}"
      },
      {
        "destination": "/user/queue/calls",
        "payload": "CallView {id,conversationId,caller,callee,status,endReason,createdAt,ringingExpiresAt,acceptedAt,endedAt,mediaClosed,revision}"
      },
      {
        "destination": "/topic/conversation.{{conversation_id}}",
        "payload": "MessageResponse {id,conversationId,senderId,senderName,senderAvatar,content,type,attachments,sentAt,status}"
      },
      {
        "destination": "/topic/conversation.{{conversation_id}}.typing",
        "payload": "{userId,isTyping}"
      },
      {
        "destination": "/topic/presence",
        "payload": "{userId,status:ONLINE|OFFLINE,lastSeen:epochMs}"
      }
    ],
    "securityExpected": [
      "CONNECT withoutvalidJWT rejected",
      "SUBSCRIBE /queue/* rejected",
      "SUBSCRIBE /user/* except /user/queue/messages and /user/queue/calls rejected",
      "SEND non/app destination rejected",
      "Nonmember /app/chat.send rejected by ChatService",
      "Nonmember conversation-topic subscribe and typing SHOULD be rejected; current source lacksmembership checks (CHAT-TOPIC-MEMBERSHIP,CHAT-TYPING-MEMBERSHIP)"
    ],
    "integrationChecks": [
      "A/Bconnect leads presenceisOnlinetrue via REST, disconnect leads false/lastSeen",
      "A SENDtext -> Bconversationtopic receives fullmessage, Buserqueue unreadcountincrements, BRESThistory persistsmessage+Identityprofile",
      "Typing sent frommember arrives ontypingtopic",
      "Call RESTinvitation -> Bprivatecallsqueue RINGING -> Baccept -> bothACCEPTED -> end -> bothENDED"
    ],
    "toolingLimit": "Postman Collection v2.1 / Newman is HTTP only; keep STOMP integration as a separate Node runner or manual Postman WebSocket session. Do not invent HTTP message-send route."
  },
  "notes": [
    "All22HTTPendpoints require validJWT; missing/malformed token returns401 {success:false,message:Unauthorized}.",
    "Conversation/currentUser group-admin authorization errors use400 in implementation, while callauthorization uses403. Document actualbehavior separately fromsecurityexpectations.",
    "Presence is Redis-backed and requires STOMPconnect to becomeonline; mereHTTP login does notmarkonline.",
    "Callsuccessresponses include Cache-Control:no-store; errors are routed throughGlobalExceptionHandler and noStore notguaranteed.",
    "Callstart requires configuredLiveKit values (URLwss://, nonblank key/secret not containingYOUR_, tokenTTL30s..5m). Realprovider networking starts only atvideo-access.",
    "Default callringtimeout60s, disconnecttimeout45s, media/reconnectgrace frontend15s; maintenance5s.",
    "Do not persist/exportparticipantToken, accessJWT, refreshJWT or providercredentials in committed artifacts/reports.",
    "No REST messagecreate/edit/delete endpoint exists in chatservice; history+read only. MessageSEND is STOMP.",
    "AUTHORIZATION FINDING CHAT-READ-MEMBERSHIP: markMessagesAsRead lacksmembership/existencecheck; outsider/nonexistentconversation currentlyreturns200.",
    "AUTHORIZATION FINDING CHAT-TOPIC-MEMBERSHIP: WebSocketAuthInterceptor doesn'tvalidate topicconversation membership onSUBSCRIBE; authenticatedoutsider canlikelyreceive messagebroadcasts. Must verifylive ratherthan claim confirmed.",
    "AUTHORIZATION FINDING CHAT-TYPING-MEMBERSHIP: /app/chat.typing broadcasts for arbitraryconversationId withoutmembershipcheck; verifylive.",
    "Identity profilefailure is swallowed and represented as Unknownprofiles; integration should assertrealprofilestoavoidfalsepass."
  ],

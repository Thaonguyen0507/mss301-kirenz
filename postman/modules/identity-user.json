      ]
    },
    {
      "name": "Friend request lifecycle and notification fan-out",
      "description": "A->B pending, verify incoming/outgoing profile enrichment, enforce receiver-only accept, then friends/status both directions; poll notification service by type/targetId rather than assume synchronous delivery.",
      "steps": [
        {
          "endpointId": "user_send_friend_request",
          "actor": "a",
          "assertions": [
            "201; requesterId=A; receiverId=B; status PENDING; capture request ID"
          ]
        },
        {
          "endpointId": "user_incoming_requests",
          "actor": "b",
          "assertions": [
            "contains request ID with requester profile matching identity A"
          ]
        },
        {
          "endpointId": "user_outgoing_requests",
          "actor": "a",
          "assertions": [
            "contains request ID with receiver profile matching identity B"
          ]
        },
        {
          "endpointId": "user_accept_friend_request",
          "actor": "outsider",
          "overrides": {
            "expectedStatuses": [
              404
            ]
          },
          "assertions": [
            "404; outsider cannot accept another actor's pending request"
          ]
        },
        {
          "endpointId": "user_accept_friend_request",
          "actor": "b",
          "assertions": [
            "200; data.friendId=A; enriched fields match identity A"
          ]
        },
        {
          "endpointId": "user_list_friends",
          "actor": "a",
          "assertions": [
            "contains B; enriched username/displayName match identity B"
          ]
        },
        {
          "endpointId": "user_friend_status",
          "actor": "b",
          "overrides": {

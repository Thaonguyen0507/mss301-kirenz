      "path": "/api/auth/google",
      "auth": "none",
      "expectedStatuses": [
        200
      ],
      "body": {
        "idToken": "{{google_id_token}}"
      },
      "tags": [
        "manual",
        "external-provider"
      ],
      "description": "Requires a real, unexpired Google ID token accepted by configured OAuth audience. Creates/links account and marks email verified; use a dedicated test Google account.",
      "source": "identity-service/src/main/java/com/kirenz/identity_service/auth/controller/AuthController.java"
    },
    {
      "id": "identity_refresh",
      "service": "identity-service",

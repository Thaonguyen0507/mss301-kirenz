        {
          "endpointId": "identity_register",
          "actor": "a",
          "assertions": [
            "201; data.id UUID; data.otpSent boolean"
          ]
        },
        {
          "endpointId": "identity_login",
          "actor": "a",
          "assertions": [
            "200; nonempty data.accessToken and refreshToken; tokenType Bearer"
          ]
        },
        {
          "endpointId": "identity_current_profile",
          "actor": "a",
          "assertions": [
            "data.id equals registration id; role USER; email equals fixture email"
          ]
        },
        {
          "endpointId": "user_privacy_me",
          "actor": "a",
          "assertions": [
            "data.userId equals identity id; defaults true/PUBLIC. HTTP get creates missing defaults, so this alone does not prove Kafka consumption."
          ]
        }
      ]
    },
    {
      "name": "Identity profile enrichment through user-service Feign",
      "description": "Change disposable actor A displayName/bio, then search and friend-list views through user-service must show the current identity values, not fallback fields.",
      "steps": [
        {
          "endpointId": "identity_update_profile",
          "actor": "a",
          "assertions": [

    {
      "id": "identity_register",
      "service": "identity-service",
      "folder": "Identity / Authentication",
      "name": "Register disposable actor",
      "method": "POST",
      "path": "/api/auth/register",
      "auth": "none",
      "expectedStatuses": [
        201
      ],
      "body": {
        "email": "{{email_a}}",
        "username": "{{username_a}}",
        "password": "{{password_a}}",
        "displayName": "{{display_name_a}}"
      },
      "captures": [
        {
          "variable": "user_a_id",
          "path": "data.id"
        }
      ],
      "tags": [
        "bootstrap",
        "writes",
        "sends-email"
      ],
      "description": "Register a unique run-scoped email/username. Always creates USER, ACTIVE, emailVerified=false and publishes user-created Kafka event. Attempts OTP email; send failure is caught and otpSent=false still returns 201. Re-registering an existing unverified email deletes/recreates that user; never use an existing real account.",
      "source": "identity-service/src/main/java/com/kirenz/identity_service/auth/controller/AuthController.java"
    },
    {
      "id": "identity_login",
      "service": "identity-service",
      "folder": "Identity / Authentication",
      "name": "Login actor A",
      "method": "POST",
      "path": "/api/auth/login",
      "auth": "none",
      "expectedStatuses": [
        200
      ],
      "body": {
        "email": "{{email_a}}",
        "password": "{{password_a}}"
      },
      "captures": [
        {
          "variable": "access_token_a",
          "path": "data.accessToken"
        },
        {
          "variable": "refresh_token_a",
          "path": "data.refreshToken"
        }
      ],
      "description": "Returns Bearer access/refresh tokens and expiresIn=900. USER role and UUID are in JWT; obtain canonical ID through GET /api/users/me. Current implementation does not require emailVerified=true.",
      "source": "identity-service/src/main/java/com/kirenz/identity_service/auth/controller/AuthController.java"
    },
    {
      "id": "identity_google_login",
      "service": "identity-service",

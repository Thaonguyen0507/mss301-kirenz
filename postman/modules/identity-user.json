  "bootstrap": {
    "mode": "disposable-registration",
    "canLoginWithoutOtp": true,
    "reason": "AuthService.login checks credentials and account status only; User.isEnabled checks status != DEACTIVATED. emailVerified is not an authentication gate.",
    "actors": [
      "a",
      "b",
      "outsider"
    ],
    "useUniqueRunScopedEmails": true,
    "sendEmailSideEffect": true,
    "registrationEmailFailureNonfatal": true,
    "cleanup": "No public account-deletion/logout endpoints. End-to-end suites may clean friendship,block,posts,conversation artifacts they created; disposable identities remain without a separate owner-managed DB teardown.",
    "admin": "ADMIN role cannot be selected during registration. Use a separately provisioned dedicated admin test account; keep moderation suite opt-in.",
    "google": "Requires a real Google ID token; manual/opt-in provider flow.",
    "otp": "Separate manual/opt-in mailbox flow; requires existing unverified actor, six-digit code, Redis and email provider; resend cooldown60s."
  },
  "flows": [
    {
      "name": "Register/login/profile across gateway",
      "description": "Bootstrap unique A,B,outsider; register creates identities then login and me resolves IDs without reading token contents.",
